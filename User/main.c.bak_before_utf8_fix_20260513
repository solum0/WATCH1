                                break;
                        }
                    }
                    
                    // 检查无操作超时 (2分钟)
                   if ((xTaskGetTickCount() - inactivityTimer) > pdMS_TO_TICKS(120000)) {
											if (xSemaphoreTake(xGlobalMutex, pdMS_TO_TICKS(100))) {	
