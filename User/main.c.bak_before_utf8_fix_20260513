												xSemaphoreGive(xGlobalMutex);
                        printf("Auto-saving due to inactivity\n");
                    }						
				}
			}
                
                // 7. 退出设置模式，执行清理和保�?
                saveAlarmSettings(); // 保存设置到DS3231
                
                if (xAlarmBlinkTimer != NULL) {
                    xTimerStop(xAlarmBlinkTimer, 0);
                    xTimerDelete(xAlarmBlinkTimer, 0);
                    xAlarmBlinkTimer = NULL;
